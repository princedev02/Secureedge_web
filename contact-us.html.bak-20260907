  <style>
    .swal-small-popup {
      width: 320px !important;
      font-size: 14px !important;
      padding: 1em !important;
      background-color: rgb(14, 13, 13);
      border: 1px solid red;
      border-radius: 24px;
      color: rgb(203, 205, 203);
    }

    .swal-small-title {
      font-size: 20px !important;
      font-family: 'Outfit', sans-serif;
    }

    .swal-small-content {
      font-size: 14px !important;
    }
  </style>

  <script>
    AOS.init({
      duration: 1400,
      easing: 'ease-in-out',
      once: true
    });

  </script>

  <script>
    (function () {
      var form = document.getElementById('contactForm');
      if (!form) return;

      var submitBtn = form.querySelector('button[type="submit"]');
      form.addEventListener('submit', function (e) {
        e.preventDefault();

        var responseEl = document.getElementById('responseMessage');
        var emailInput = document.getElementById('email');
        var replyto = document.getElementById('_replyto');
        if (emailInput && replyto) replyto.value = emailInput.value || '';

        if (submitBtn) {
          submitBtn.disabled = true;
          var originalText = submitBtn.innerHTML;
          submitBtn.innerHTML = 'Sending...';
        }

        var formData = new FormData(form);

        fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        }).then(function (response) {
          if (response.ok) {
            if (window.Swal) {
              Swal.fire({ icon: 'success', title: 'Thank you!', text: "We've received your request and will contact you soon.", timer: 3000, showConfirmButton: false, customClass: { popup: 'swal-small-popup', title: 'swal-small-title', content: 'swal-small-content' } });
            }
            if (responseEl) {
              responseEl.style.display = 'block';
              responseEl.style.color = 'rgb(52, 221, 22)';
              responseEl.textContent = 'Thank you for contacting us. Our team will get back to you shortly.';
            }
            form.reset();
          } else {
            response.json().then(function (data) {
              var errText = 'There was a problem submitting the form.';
              if (data && data.errors) {
                errText = data.errors.map(function (err) { return err.message; }).join(', ');
              }
              if (window.Swal) {
                Swal.fire({ icon: 'error', title: 'Submission error', text: errText });
              }
              if (responseEl) {
                responseEl.style.display = 'block';
                responseEl.style.color = 'rgb(255, 80, 80)';
                responseEl.textContent = errText;
              }
            }).catch(function () {
              if (window.Swal) {
                Swal.fire({ icon: 'error', title: 'Submission failed', text: 'Please try again.' });
              }
              if (responseEl) {
                responseEl.style.display = 'block';
                responseEl.style.color = 'rgb(255, 80, 80)';
                responseEl.textContent = 'Submission failed. Please try again.';
              }
            });
          }
        }).catch(function () {
          if (window.Swal) {
            Swal.fire({ icon: 'error', title: 'Network error', text: 'Please check your connection and try again.' });
          }
          if (responseEl) {
            responseEl.style.display = 'block';
            responseEl.style.color = 'rgb(255, 80, 80)';
            responseEl.textContent = 'Network error. Please check your connection and try again.';
          }
        }).finally(function () {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText || 'Get A Call Back';
          }
        });
      });
    })();
  </script>
