    <script>
        (function () {
            const area = document.getElementById('uploadArea');
            const input = document.getElementById('resumeUpload');
            const label = document.getElementById('uploadFileName');
            const allowed = ['.pdf', '.doc', '.docx'];

            function setFile(file) {
                if (!file) return;
                const ext = '.' + file.name.split('.').pop().toLowerCase();
                if (!allowed.includes(ext)) {
                    label.textContent = 'Invalid file type. Use PDF or DOC.';
                    label.style.color = '#FF5555';
                    return;
                }
                if (file.size > 5 * 1024 * 1024) {
                    label.textContent = 'File exceeds 5 MB limit.';
                    label.style.color = '#FF5555';
                    return;
                }
                label.textContent = file.name;
                label.style.color = '';
            }

            input.addEventListener('change', () => setFile(input.files[0]));

            // ── Custom role dropdown ────────────────────────
            const roleDropdown = document.getElementById('roleDropdown');
            const roleValue    = document.getElementById('roleValue');
            const roleText     = document.getElementById('roleText');

            window.toggleRoleDropdown = function() {
                const isOpening = !roleDropdown.classList.contains('open');
                roleDropdown.classList.toggle('open');
                // Hide the other-input while dropdown is open so it doesn't overlap options
                if (roleOtherWrapper) {
                    roleOtherWrapper.style.visibility = isOpening ? 'hidden' : 'visible';
                }
            };

            const roleOtherWrapper = document.getElementById('roleOtherWrapper');
            const roleOtherInput   = document.getElementById('roleOtherInput');

            window.selectRoleOption = function(opt) {
                document.querySelectorAll('#roleOptions .custom-option').forEach(o => o.classList.remove('selected'));
                opt.classList.add('selected');
                roleDropdown.classList.remove('open');

                if (opt.dataset.value === '__other__') {
                    roleOtherWrapper.style.display = 'block';
                    roleOtherWrapper.style.visibility = 'visible';
                    roleText.textContent = 'Other — specify your role';
                    roleText.classList.remove('placeholder');
                    roleValue.value = '';
                    setTimeout(() => roleOtherInput.focus(), 50);
                } else {
                    roleOtherWrapper.style.display = 'none';
                    roleOtherWrapper.style.visibility = 'visible';
                    roleOtherInput.value = '';
                    roleValue.value = opt.dataset.value;
                    roleText.textContent = opt.dataset.value;
                    roleText.classList.remove('placeholder');
                }
            };

            // Sync typed value into hidden input live
            roleOtherInput.addEventListener('input', function() {
                roleValue.value = this.value.trim();
            });

            document.querySelectorAll('#roleOptions .custom-option').forEach(opt => {
                opt.addEventListener('click', () => selectRoleOption(opt));
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (roleDropdown && !roleDropdown.contains(e.target)) {
                    roleDropdown.classList.remove('open');
                    if (roleOtherWrapper) roleOtherWrapper.style.visibility = 'visible';
                }
            });

            area.addEventListener('dragover', function (e) {
                e.preventDefault();
                area.style.borderColor = '#FF5555';
            });

            area.addEventListener('dragleave', function () {
                area.style.borderColor = '';
            });

            area.addEventListener('drop', function (e) {
                e.preventDefault();
                area.style.borderColor = '';
                const file = e.dataTransfer.files[0];
                if (file) {
                    const dt = new DataTransfer();
                    dt.items.add(file);
                    input.files = dt.files;
                }
                setFile(file);
            });
        })();
    </script>
