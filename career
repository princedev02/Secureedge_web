    <script>
        (function () {
            var form = document.getElementById('contactForm');
            if (!form) return;

            var submitBtn = form.querySelector('button[type="submit"]');
            var swalCls = { popup: 'swal-small-popup', title: 'swal-small-title', content: 'swal-small-content' };

            form.addEventListener('submit', function (e) {
                e.preventDefault();

                // ── Role validation (hidden input; browser ignores `required` on hidden fields)
                var roleVal = (document.getElementById('roleValue').value || '').trim();
                if (!roleVal) {
                    var otherWrapper = document.getElementById('roleOtherWrapper');
                    if (otherWrapper && otherWrapper.style.display !== 'none') {
                        if (window.Swal) Swal.fire({ icon: 'error', title: 'Role required', text: 'Please type your desired role in the field below the dropdown.', customClass: swalCls });
                    } else {
                        if (window.Swal) Swal.fire({ icon: 'error', title: 'Role required', text: 'Please select a role from the dropdown.', customClass: swalCls });
                    }
                    return;
                }

                // ── Resume validation
                var resumeFile = document.getElementById('resumeUpload').files[0];
                if (!resumeFile) {
                    if (window.Swal) Swal.fire({ icon: 'error', title: 'Resume required', text: 'Please upload your resume (PDF, DOC, or DOCX).', customClass: swalCls });
                    return;
                }

                if (submitBtn) {
                    submitBtn.disabled = true;
                    var originalText = submitBtn.innerHTML;
                    submitBtn.innerHTML = 'Sending...';
                }

                var formData = new FormData(form);

                fetch(form.action, {
                    method: 'POST',
                    body: formData
                }).then(function (response) {
                    return response.json();
                }).then(function (data) {
                    if (data.success) {
                        if (window.Swal) {
                            Swal.fire({ icon: 'success', title: 'Thank you ! We’ll respond shortly.', text: data.message, timer: 3000, showConfirmButton: false, customClass: { popup: 'swal-small-popup', title: 'swal-small-title', content: 'swal-small-content' } });
                        }
                        form.reset();
                        document.getElementById('uploadFileName').textContent = 'Pdf, Doc up to 5 Mb';
                    } else {
                        if (window.Swal) {
                            Swal.fire({ icon: 'error', title: 'Submission error', text: data.message || 'There was a problem submitting the form.', customClass: { popup: 'swal-small-popup', title: 'swal-small-title', content: 'swal-small-content' } });
                        }
                    }
                }).catch(function () {
                    if (window.Swal) {
                        Swal.fire({ icon: 'error', title: 'Network error', text: 'Please check your connection and try again.', customClass: { popup: 'swal-small-popup', title: 'swal-small-title', content: 'swal-small-content' } });
                    }
                }).finally(function () {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText || 'Submit';
                    }
                });
            });

            // Show selected file name in upload area
            document.getElementById('resumeUpload').addEventListener('change', function () {
                var fileName = this.files[0] ? this.files[0].name : 'Pdf, Doc up to 5 Mb';
                document.getElementById('uploadFileName').textContent = fileName;
            });
        })();
    </script>
