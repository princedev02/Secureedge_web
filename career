<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="./assets/images/se-logo-favicon.png" />
    <title>SecureEdge - Career Page</title>
    <meta name="description" content=" Explore career opportunities at SecureEdge Fintech. Join our team building AEPS, KYC and identity verification technology for banks across India.">
    <meta name="keywords" content="Digital Account Opening Platform,
Digital Account Opening Solution">

    <link rel="canonical" href="https://secureedgefintech.com/openedge.html" />

    <link rel="icon" type="image/png" href="./assets/images/se-logo-favicon.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Outfit" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <!-- <link href="https://db.onlinewebfonts.com/c/2cf31cbaf98b296b692adb4ed0483799?family=Qurova+DEMO" rel="stylesheet" /> -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
    <link rel="stylesheet" type="text/css"
        href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <link rel="stylesheet" href="./assets/css/reset.css" />
    <link rel="stylesheet" href="./assets/css/style.css" />
    <!-- <link rel="stylesheet" href="./assets/css/custome.css" /> -->
    <link rel="stylesheet" href="./assets/css/bdadge.css" />
    <style>
        * {
            padding: 0;
            margin: 0;
        }

        .bgadge-section-main-wrapper .main-content h1 {
            max-width: 600px;
            margin: 0 auto;
        }

        .bgadge-section-main-wrapper .main-content p {
            padding: 20px 10px;
            max-width: 900px;
            font-size: 20px;
            color: #D3D3D3;
        }

        .careerwrap {
            padding-top: 120px;
        }

        .hero-badge {
            display: flex;
            background: #FB2C361A;
            border: 1px solid #FB2C3633;
            border-radius: 999px;
            padding: 8px 24px;
            font-size: 16px;
            color: #FF5252;
            margin: 30px auto;
        }

        .highlight {
            color: #FF5252;
            font-weight: 700;
            font-family: Qurova DEMO;
        }

        .hero-buttons {
            display: flex;
            gap: 16px;
            justify-content: center
        }

        .btn-primary {
            background: #FB2C36;
            color: var(--white);
            border: none;
            border-radius: 20px;
            padding: 14px 32px;
            font-size: 15px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration:none;
        }

        .btn-primary svg {
            width: 16px;
            height: 16px;
            transform: rotate(90deg)
        }

        .btn-outline {
            border: 1px solid #FB2C364D;
            background: black;
            border-radius: 20px;
            padding: 14px 32px;
            font-size: 15px;
            cursor: pointer;
            color: #ffffff;
        }

        .bgadge-section-main-wrapper .wrapper-container {
            margin-top: 100px;
        }

        .hero-watermark {
            font-family: 'Roboto', sans-serif;
            font-weight: 600;
            font-size: 120px;
            text-transform: uppercase;
            background: linear-gradient(to bottom, rgb(216 208 208 / 19%), rgb(247 247 247 / 7%));
            /* background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(0, 0, 0, 0.04) 100%); */
            /* 
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent; */
            background-clip: text;
            color: transparent;
            position: absolute;
            bottom: 10%;
            left: 0;
            transform: translateX(-50%);
            white-space: nowrap
        }

        /* [data-aos="slide-to-initial"] {
            opacity: 0;
            transform: translateX(-50%) translateY(60px);
            transition-property: transform, opacity;
        }

        [data-aos="slide-to-initial"].aos-animate {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        } */

        /* SECTION COMMON */
        section {
            /* max-width: 1200px; */
            margin: 0 auto;
            padding: 20px 0
        }

        .section-label {
            font-weight: 500;
            font-size: 20px;
            color: #FF5555;
            letter-spacing: 2.2px;
            margin-bottom: 12px
        }

        .section-title {
            font-weight: 600;
            font-size: 36px;
            color: #FFFFFF;
            line-height: 48px;
            margin-bottom: 0;
            font-family: Qurova DEMO;
        }

        .section-desc {
            font-size: 16px;
            color: #D3D3D3;
            line-height: 28px;
            max-width: 550px;
            margin-bottom: 70px;
        }

        .desc2 {
            max-width: 450px;
        }

        /* WHY CARDS */
        .why-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-top: 40px
        }

        .why-card {
            background:
                linear-gradient(#191919, #191919) padding-box,
                linear-gradient(180deg, #0A0A0A 0%, #c5c3c3bd 100%) border-box;
            border: 1px solid transparent;
            border-radius: 16px;
            padding: 15px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .why-card:hover {
            box-shadow: 0px -2px 2px rgba(255, 255, 255, 0.2);
            transform: translateY(-8px);
        }

        .why-icon {
            width: 40px;
            height: 40px;
            background: #FF55552E;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 24px
        }

        .why-icon svg {
            width: 20px;
            height: 20px;
            color: #FF5555
        }

        .why-card h3 {
            /* font-family: var(--font-display); */
            font-weight: 600;
            font-size: 20px;
            color: #FF5555;
            letter-spacing: 2.2px;
            margin-bottom: 8px
        }

        .why-card p {
            font-size: 16px;
            color: var(--gray);
            line-height: 26px
        }

        .redtext {
            color: #FF5555;
        }

        .divider {
            height: 1px;
            background: linear-gradient(320deg, #FF5A5A 19%, #0000000e 61%);
            margin: -10px 0 20px
        }

        .hiring-text {
            font-family: Aeonik TRIAL;
            font-weight: 700;
            font-size: 85px;
            -webkit-text-stroke: 0.5px #595959;
            color: transparent;
            margin: 20px 0
        }

        /* OPEN POSITIONS */
        .filter-tabs {
            display: flex;
            gap: 16px;
            margin: 30px 0 40px
        }

        .filter-tab {
            border-radius: 999px;
            padding: 8px 24px;
            font-size: 16px;
            cursor: pointer;
            border-top: 0.67px solid #FB2C361A;
            background: #1a1a1a;
            color: #D3D3D3;
        }

        .filter-tab.active {
            background: #FF5555;
            color: #ffffff;
            box-shadow: 0px 4px 6px -4px #FB2C3633;
            box-shadow: 0px 10px 15px -3px #FB2C3633;
            box-shadow: 0 10px 15px rgba(251, 44, 54, .2)
        }

        .job-card {
            background: #161616;
            border: 0.67px solid #FB2C3633;
            border-radius: 16px;
            padding: 28px;
            margin-bottom: 24px;
            position: relative;
            display: flex;
            flex-direction: column;
            min-height: 210px
        }

        .job-card h3 {
            font-weight: 500;
            font-size: 24px;
            line-height: 32px;
            margin-bottom: 8px
        }

        .job-meta {
            display: flex;
            gap: 20px;
            margin-bottom: 8px;
            font-size: 16px;
            color: #D3D3D3;
        }

        .job-meta span {
            display: flex;
            align-items: center;
            gap: 6px
        }

        .job-meta svg {
            width: 14px;
            height: 14px;
            opacity: .7
        }

        .job-desc {
            font-size: 16px;
            color: #D3D3D3;
            line-height: 26px;
            margin-bottom: 16px;
            flex: 1
        }

        .job-tags {
            display: flex;
            gap: 8px
        }

        .job-tag {
            background: #252525;
            border: 1px solid #FB2C361A;
            border-radius: 22px;
            padding: 4px 16px;
            font-size: 16px;
            color: #D3D3D3;
        }

        .job-badge {
            position: absolute;
            top: 28px;
            right: 28px;
            background: #FB2C361A;
            border: 1px solid #FB2C3633;
            border-radius: 26px;
            padding: 6px 10px;
            font-size: 14px;
            font-weight: 500;
            color: #FF6467;
        }

        /* JOB CARD HOVER */
        .job-card {
            cursor: pointer;
            transition: border-color .2s, transform .2s
        }

        .job-card:hover {
            /* border-color: #FF5555; */
            transform: translateY(-2px)
        }

        /* JOB MODAL */
        .job-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .78);
            backdrop-filter: blur(6px);
            z-index: 1055;
            align-items: center;
            justify-content: center;
            padding: 20px
        }

        .job-modal-overlay.open {
            display: flex
        }

        .job-modal {
            background: #161616;
            border: 1px solid rgba(251, 44, 54, .25);
            border-radius: 24px;
            padding: 40px;
            max-width: 720px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
            font-family: 'Outfit', sans-serif
        }

        .job-modal-close {
            position: absolute;
            top: 18px;
            right: 22px;
            background: none;
            border: none;
            color: #99a1af;
            cursor: pointer;
            font-size: 26px;
            line-height: 1
        }

        .job-modal-close:hover {
            color: #fff
        }

        .job-modal-cat {
            display: inline-block;
            background: rgba(251, 44, 54, .1);
            border: 1px solid rgba(251, 44, 54, .2);
            border-radius: 8px;
            padding: 2px 10px;
            font-size: 12px;
            font-weight: 500;
            color: #ff6467;
            margin-bottom: 12px
        }

        .job-modal h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 26px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 12px
        }

        .job-modal-meta {
            display: flex;
            gap: 20px;
            font-size: 15px;
            color: #D3D3D3;
            margin-bottom: 18px;
            flex-wrap: wrap
        }

        .job-modal-meta span {
            display: flex;
            align-items: center;
            gap: 6px
        }

        .job-modal-meta svg {
            width: 14px;
            height: 14px;
            opacity: .7
        }

        .job-modal-hr {
            height: 1px;
            background: rgba(251, 44, 54, .2);
            margin: 18px 0
        }

        .job-modal-label {
            font-size: 12px;
            font-weight: 600;
            color: #ff6467;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            margin-bottom: 10px
        }

        .job-modal p {
            font-size: 15px;
            color: #D3D3D3;
            line-height: 26px;
            margin-bottom: 14px
        }

        .job-modal ul {
            list-style: none;
            padding: 0;
            margin-bottom: 14px
        }

        .job-modal ul li {
            font-size: 15px;
            color: #D3D3D3;
            line-height: 26px;
            padding-left: 18px;
            position: relative;
            margin-bottom: 6px
        }

        .job-modal ul li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 10px;
            width: 6px;
            height: 6px;
            background: #FF5555;
            border-radius: 50%
        }

        .job-modal-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 20px
        }

        .job-modal-inforow {
            display: flex;
            gap: 20px;
            margin-bottom: 18px
        }

        .job-modal-infobox {
            background: #252525;
            border-radius: 10px;
            padding: 10px 18px
        }

        .job-modal-infobox small {
            display: block;
            font-size: 12px;
            color: #99a1af;
            margin-bottom: 3px
        }

        .job-modal-infobox span {
            font-size: 15px;
            font-weight: 500;
            color: #fff
        }

        .job-modal-applybtn {
            background: #FF5555;
            color: #fff;
            border: none;
            border-radius: 20px;
            padding: 14px 36px;
            font-size: 15px;
            font-family: 'Outfit', sans-serif;
            cursor: pointer;
            width: 100%;
            margin-top: 6px
        }

        .job-modal-applybtn:hover {
            background: #fb2c36
        }

        /* NO JOBS EMPTY STATE */
        .no-jobs-card {
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 80px 40px;
            background: #161616;
            border: 0.67px solid #FB2C3633;
            border-radius: 16px;
            margin-bottom: 24px;
        }

        .no-jobs-card.visible {
            display: flex;
        }

        /* span full grid row so centering works */
        #noJobsCard {
            grid-column: 1 / -1;
        }

        .no-jobs-icon {
            width: 72px;
            height: 72px;
            background: rgba(251, 44, 54, 0.15);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 28px;
        }

        .no-jobs-icon i {
            font-size: 28px;
            color: #FF5555;
        }

        .no-jobs-card h3 {
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 14px;
        }

        .no-jobs-card p {
            font-size: 16px;
            color: #D3D3D3;
            max-width: 480px;
            line-height: 26px;
        }

        /* APPLY */
        .apply-section {
            padding: 80px 0
        }

        .apply-form-wrapper {
            margin-top: 40px;
            background: #6E6E6E2B;
            backdrop-filter: blur(9px);
            border: 1px solid #FC3131;
            border-bottom: none;
            border-radius: 50px;
            padding: 40px 50px;
            max-width: 1169px;
            margin-left: auto;
            margin-right: auto
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px 40px;
            overflow: visible;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px
        }

        .form-group label {
            font-size: 16px;
            color: #E0E0E0;
        }

        .form-group input,
        .form-group select {
            background: rgba(13, 13, 13, .17);
            backdrop-filter: blur(9px);
            border: 1px solid #474747;
            border-radius: 10px;
            padding: 14px 16px;
            font-size: 16px;
            outline: none;
            color: #ffffff;
        }

        .input-icon-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon-wrapper input,
        .input-icon-wrapper select {
            width: 100%;
            padding-left: 42px;

        }

        .input-icon-wrapper .input-icon {
            position: absolute;
            left: 14px;
            color: #f7f7f7;
            font-size: 15px;
        }


        .form-upload {
            grid-column: 1/-1
        }

        .upload-area {
            background: rgba(13, 13, 13, .17);
            backdrop-filter: blur(9px);
            border: 1px solid #474747;
            border-radius: 10px;
            padding: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 180px;
            cursor: pointer
        }

        .upload-area svg {
            width: 40px;
            height: 40px;
            color: #666;
            margin-bottom: 16px
        }

        .upload-area p {
            font-size: 20px;
            color: var(--gray3)
        }

        .upload-area p span {
            color: #FF5555;
        }

        .upload-area small {
            font-size: 16px;
            color: #c9c9c9;
            margin-top: 8px
        }

        /* ── CUSTOM ROLE DROPDOWN ── */
        .custom-select-wrapper { position: relative; width: 100%; z-index: 100; }
        .custom-select {
            background: rgba(13,13,13,.17);
            backdrop-filter: blur(9px);
            border: 1px solid #474747;
            border-radius: 10px;
            position: relative;
            cursor: pointer;
            user-select: none;
        }
        .custom-select.open { border-color: #FF5555; }
        .custom-select-trigger {
            display: flex;
            align-items: center;
            padding: 14px 16px 14px 42px;
            font-size: 16px;
            color: #fff;
        }
        .custom-select-trigger .cs-icon {
            position: absolute;
            left: 14px;
            color: #f7f7f7;
            font-size: 15px;
            pointer-events: none;
        }
        .custom-select-trigger .cs-text { flex: 1; }
        .custom-select-trigger .cs-text.placeholder { color: #888; }
        .custom-select-trigger .cs-arrow {
            font-size: 12px;
            color: #888;
            transition: transform 0.2s;
            margin-left: 8px;
        }
        .custom-select-options{
            /* border:1px solid #ee4e4e !important; */
        }
        .custom-select.open .cs-arrow { transform: rotate(180deg); }
        .custom-select-options {
            position: absolute;
            top: calc(100% + 6px);
            left: 0; right: 0;
            background: #1a1a1a;
            border: 1px solid #474747;
            border-radius: 10px;
            z-index: 9999;
            display: none;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            max-height: 220px;
            overflow-y: auto;
        }
        .custom-select.open .custom-select-options { display: block; }
        .custom-option {
            padding: 12px 16px;
            font-size: 15px;
            color: #ccc;
            cursor: pointer;
            transition: background 0.15s, color 0.15s;
        }
        .custom-option:hover    { background: rgba(255,85,85,0.12); color: #fff; }
        .custom-option.selected { background: rgba(255,85,85,0.18); color: #FF5555; font-weight: 500; }
        .custom-option-other { border-top: 1px solid #2a2a2a; color: #888 !important; font-style: italic; }
        .custom-option-other:hover { color: #fff !important; }

        .submit-btn {
            background: #FFFFFF;
            color: #FF0A0A;
            border: none;
            border-radius: 23px;
            padding: 12px 60px;
            font-weight: 600;
            font-size: 18px;
            cursor: pointer;
            margin-top: 30px
        }

        /* CULTURE */
        .culture-section {
            text-align: center;
            padding: 80px 0 40px
        }

        .culture-section .section-desc {
            text-align: left;
            max-width: 576px;
        }

        .culture-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin-top: 40px;
            text-align: left
        }

        /* REVIEWS */
        .reviews-section {
            padding: 60px 0 80px
        }

        .review-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-top: 40px
        }

        .review-carousel {
            display: block !important;
            margin-top: 40px
        }

        .review-carousel .slick-list {
            margin: 0 -12px
        }

        .review-carousel .slick-slide {
            margin: 0 12px
        }

        .review-nav {
            display: flex;
            justify-content: right;
            gap: 16px;
            margin-top: 32px
        }

        .review-nav-btn {
            width: 48px;
            height: 48px;
            background: #ffffff;
            border: 1px solid #2a2a2a;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.2s, border-color 0.2s
        }

        .review-nav-btn:hover {
            background: #252525;
            border-color: #FF5555
        }

        .review-nav-btn svg {
            width: 20px;
            height: 20px;
            stroke: #FF5555;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round
        }

        .review-card {
            background:
                linear-gradient(#191919, #191919) padding-box,
                linear-gradient(180deg, #0A0A0A 0%, #c5c3c3bd 100%) border-box;
            border: 1px solid transparent;
            border-radius: 16px;
            padding: 20px 28px;
            min-height: 320px;
        }

        .review-header {
            display: flex;
            gap: 16px;
            align-items: flex-start;
            margin-bottom: 16px
        }

        .review-avatar {
            width: 48px;
            height: 48px;
            background: #FF5555;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0
        }

        .review-info h4 {
            font-weight: 500;
            font-size: 18px;
            margin-bottom: 4px
        }

        .review-info p {
            font-size: 14px;
            color: var(--gray)
        }

        .review-info small {
            font-size: 12px;
            color: var(--gray)
        }

        .review-stars {
            display: flex;
            gap: 4px;
            margin-bottom: 12px;
            fill: #FF5555 !important;
        }

        .review-stars svg {
            width: 20px;
            height: 20px;
            fill: #FF5555 !important
        }

        .review-text {
            font-size: 16px;
            color: var(--gray);
            line-height: 26px
        }

        .redtext {
            color: #FF5555;
        }

        /* RESPONSIVE */
        @media (max-width: 991px) {
            .why-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .culture-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            section {
                padding: 40px 16px;
            }

            .careerwrap {
                padding-top: 80px;
            }

            .bgadge-section-main-wrapper .main-content p {
                font-size: 16px;
                padding: 14px 6px;
            }

            .hero-buttons {
                flex-direction: column;
                align-items: center;
            }

